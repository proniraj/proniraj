---
import { SITE, LINKS } from "../consts";

const mailto = `mailto:${SITE.email}?subject=Job%20Opportunity%20%E2%80%94%20${encodeURIComponent(SITE.title)}`;
---

<header class="max-w-3xl mx-auto px-6 pt-14 pb-10 w-full">
  <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-5">
    <span class="gradient-text">{SITE.title}</span>
  </h1>

  <p class="text-xl sm:text-2xl text-white/95 font-medium leading-snug max-w-xl mb-4">
    Full-stack engineer building banking platforms and product software.
  </p>

  <p class="text-base text-text-muted leading-relaxed max-w-lg mb-8">
    Currently at Peace Nepal — CMS and page builders for banks, plus React Native when the
    product needs a phone. Outside work: local-first systems and Rust.
  </p>

  <nav class="flex flex-wrap gap-3 mb-6" aria-label="Primary actions">
    <a href={mailto} class="btn-primary">Email me</a>
    <a href={LINKS.resume} class="btn-secondary" target="_blank" rel="noopener noreferrer"
      >Resume</a
    >
  </nav>

  <p class="text-xs font-mono text-text-muted/80">
    {SITE.location} · {SITE.timezone} · Open to remote · {SITE.overlap}
  </p>
</header>
