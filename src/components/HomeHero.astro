---
import { SITE, LINKS, PROOF } from "../consts";

const mailto = `mailto:${SITE.email}?subject=Job%20Opportunity%20%E2%80%94%20${encodeURIComponent(SITE.title)}`;
---

<header class="max-w-3xl mx-auto px-6 py-12 w-full">
  <p class="font-mono text-sm text-text-muted mb-4">Home</p>

  <h1 class="text-3xl sm:text-4xl font-bold mb-2">
    <span class="gradient-text">{SITE.title}</span>
  </h1>
  <p class="text-lg text-white mb-4">
    Full-stack engineer: production TypeScript systems, with a systems-level edge.
  </p>

  <p class="text-text-muted leading-relaxed max-w-2xl mb-6">
    I've spent 4+ years shipping SaaS, fintech, and AI products for remote teams in the UK,
    Netherlands, and US — from React through NestJS services to deploy. Lately I build below the
    framework: P2P networking, offline-first caching, and a POSIX shell in Rust.
  </p>

  <p class="text-sm font-mono text-text-muted mb-2">
    <span class="text-white/80">Shipped for</span>
    {" "}
    {PROOF.clients.join(" · ")}
  </p>
  <p class="text-sm font-mono text-text-muted mb-6">
    <span class="text-white/80">Upstream</span>
    {" "}
    <a
      href={LINKS.imapflowPr}
      class="text-blue-400 hover:text-blue-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">{PROOF.upstream}</a
    >
    {" "}(merged)
  </p>

  <p class="text-sm text-text-muted font-mono mb-8">
    {SITE.location} · {SITE.timezone} · {SITE.overlap}
  </p>

  <nav class="flex flex-wrap gap-3" aria-label="Primary actions">
    <a href={mailto} class="btn-primary">Email me</a>
    <a href={LINKS.resume} class="btn-secondary" target="_blank" rel="noopener noreferrer"
      >Résumé</a
    >
    <a href="/work" class="btn-secondary">Selected work</a>
  </nav>
</header>
