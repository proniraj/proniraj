---
import { SITE, LINKS } from "../consts";
---

<header class="max-w-3xl mx-auto px-6 py-12 w-full">
  <p class="font-mono text-sm text-text-muted mb-4">Home</p>

  <h1 class="text-3xl sm:text-4xl font-bold mb-2">
    <span class="gradient-text">{SITE.title}</span>
  </h1>
  <p class="text-lg text-white mb-3">{SITE.tagline}</p>

  <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-mono mb-5" aria-label="Quick links">
    <a
      href={LINKS.linkedin}
      class="text-blue-400 hover:text-blue-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">LinkedIn</a
    >
    <span class="text-dark-border">·</span>
    <a
      href={LINKS.github}
      class="text-blue-400 hover:text-blue-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">GitHub</a
    >
    <span class="text-dark-border">·</span>
    <a
      href={LINKS.resume}
      class="text-blue-400 hover:text-blue-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">Resume</a
    >
    <span class="text-dark-border">·</span>
    <a
      href={`mailto:${SITE.email}?subject=Job%20Opportunity%20%E2%80%94%20${encodeURIComponent(SITE.title)}`}
      class="text-blue-400 hover:text-blue-300 transition-colors">Email</a
    >
  </nav>

  <p class="text-base text-text-muted mb-4 max-w-xl">
    Building SaaS, Fintech & AI Products From Idea to Production
  </p>
  <p class="text-sm text-text-muted font-mono mb-6">
    {SITE.location} · Open to Remote Opportunities
  </p>

  <div class="flex flex-wrap items-center gap-3 mb-6">
    <span class="status-indicator bg-green-900/20 border border-green-500/30 text-green-400">
      <span class="status-dot bg-green-400 animate-pulse"></span>
      ACTIVELY LOOKING
    </span>
  </div>

  <p class="text-white leading-relaxed max-w-2xl mb-4 font-medium">
    I help startups turn ideas into production software.
  </p>
  <p class="text-text-muted leading-relaxed max-w-2xl mb-8">
    Over the last 4+ years, I've shipped SaaS, fintech, AI, and mobile products for startups and
    international clients. I work across frontend, backend, infrastructure, and deployment — taking
    features from concept to production with a focus on speed, ownership, and business impact.
  </p>

  <nav class="flex flex-wrap gap-3" aria-label="Primary actions">
    <a href={LINKS.resume} class="btn-primary" target="_blank" rel="noopener noreferrer"
      >Download Resume</a
    >
    <a href={LINKS.linkedin} class="btn-secondary" target="_blank" rel="noopener noreferrer"
      >View LinkedIn</a
    >
    <a href={LINKS.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a
    >
    <a
      href={`mailto:${SITE.email}?subject=Job%20Opportunity%20%E2%80%94%20${encodeURIComponent(SITE.title)}`}
      class="btn-secondary">Email Me</a
    >
  </nav>
</header>
