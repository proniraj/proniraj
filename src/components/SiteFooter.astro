---
import { SITE } from "../consts";

interface Props {
  maxWidth?: "3xl" | "4xl";
  tagline?: string;
}

const { maxWidth = "3xl", tagline = "I help startups turn ideas into production software." } =
  Astro.props;
const widthClass = maxWidth === "4xl" ? "max-w-4xl" : "max-w-3xl";
---

<footer class={`${widthClass} mx-auto px-6 py-8 w-full mt-auto`}>
  <div class="border-t border-dark-border pt-6 text-center text-text-muted text-sm font-mono">
    <p>© {new Date().getFullYear()} {SITE.author} · {SITE.tagline} · {SITE.location}</p>
    <p class="mt-2 text-xs">{tagline}</p>
    <p class="mt-3 text-xs">
      Built with
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-400/80 hover:text-blue-300 transition-colors"
      >
        Astro
      </a>
    </p>
  </div>
</footer>
