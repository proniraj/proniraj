---
import { SITE, LINKS, PROOF } from "../consts";

const mailto = `mailto:${SITE.email}?subject=Job%20Opportunity%20%E2%80%94%20${encodeURIComponent(SITE.title)}`;

interface SystemsProject {
  title: string;
  blurb: string;
  bullets: string[];
  stack: string;
  href?: string;
}

const systemsProjects: SystemsProject[] = [
  {
    title: "Local-first music player",
    blurb:
      "A React Native music player that treats the network as optional — YouTube Music integration, chunked offline cache, and stream/download state per track on mobile.",
    bullets: [
      "Built with React Native — same TypeScript skills as production web, on iOS/Android",
      "Chunked offline cache with resume for partial downloads",
      "Stream vs download manager with progress and retry — not just a streaming UI wrapper",
    ],
    stack: "React Native · local-first · offline cache · media pipelines",
    href: LINKS.musicPlayerRepo || undefined,
  },
  {
    title: "Cross-platform P2P file transfer",
    blurb:
      "Direct peer-to-peer file transfer across macOS, Windows, Linux, Android, and iOS — no cloud upload required for the transfer path.",
    bullets: [
      "Discovery and connection negotiation across heterogeneous OSes",
      "Chunked streaming with integrity checks and resume",
      "Platform constraints (especially mobile) treated as first-class design input",
    ],
    stack: "Networking · concurrency · cross-platform",
    href: LINKS.p2pTransferRepo || undefined,
  },
  {
    title: "POSIX shell in Rust",
    blurb:
      "A POSIX-style shell built from scratch in Rust (CodeCrafters) — process lifecycle, pipes, redirection, and builtins without shell libraries.",
    bullets: [
      "Pipelines and I/O redirection across child processes",
      "Builtins run in-process (cd cannot be an external binary)",
      "Parser for quoting and escaping rules",
    ],
    stack: "Rust · OS primitives · memory safety",
    href: LINKS.rustShellRepo || undefined,
  },
];
---

<!-- Banking & fintech (current) -->
<section class="mb-10 border-t border-dark-border pt-8">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <h2 class="section-label mb-1">Banking &amp; fintech</h2>
      <p class="text-xs text-text-muted">
        Peace Nepal DOT Com · public sites only — no internal tooling
      </p>
    </div>
    <a
      href={LINKS.peaceNepal}
      class="text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">peacenepal.com →</a
    >
  </div>

  <div class="space-y-4">
    <article class="panel">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h3 class="font-semibold text-lg">NMB Bank</h3>
        <span class="text-xs font-mono text-text-muted">PNDC · Present</span>
      </div>
      <p class="text-xs font-mono text-emerald-400 mb-3">
        CMS-driven site · drag-and-drop page builder · Next.js
      </p>
      <p class="text-sm text-text-muted mb-4">
        Frontend for a Class-A commercial bank's fully CMS-driven public website (197 branches,
        2.2M+ customers, per nmb.com.np). Every page, menu, and content block is editable from an
        admin panel, in English and Nepali. Built the drag-and-drop page builder the bank's team
        uses to compose internal pages from validated blocks — same pattern refined earlier at
        Hourmarket.
      </p>
      <div class="flex flex-wrap gap-4 text-xs font-mono">
        <a
          href={LINKS.nmbBank}
          class="text-emerald-400 hover:text-emerald-300 transition-colors"
          target="_blank"
          rel="noopener noreferrer">Live site →</a
        >
        <a
          href="/work/nmb-bank-cms-page-builder"
          class="text-blue-400 hover:text-blue-300 transition-colors">Case study →</a
        >
        {
          LINKS.nmbPageBuilderVideo ? (
            <a
              href={LINKS.nmbPageBuilderVideo}
              class="text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              Clean-room demo →
            </a>
          ) : (
            <span class="text-text-muted/70">Clean-room demo pending</span>
          )
        }
      </div>
    </article>

    <article class="panel">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h3 class="font-semibold text-lg">Shine Resunga Development Bank</h3>
        <span class="text-xs font-mono text-text-muted">PNDC · Present</span>
      </div>
      <p class="text-xs font-mono text-amber-400 mb-3">
        Online demat · regulated KYC onboarding
      </p>
      <p class="text-sm text-text-muted mb-4">
        Frontend for the online demat-account application — a regulated KYC flow for a
        CDSC Depository Participant. Eligibility gating (existing savings account), document /
        photo / signature uploads with clear rejection rules, minor/guardian paths, and bilingual
        English/Nepali guidance. Public assets use jQuery and Bootstrap on a Laravel-style backend;
        described accurately, not as React.
      </p>
      <div class="flex flex-wrap gap-4 text-xs font-mono">
        <a
          href={LINKS.srdbDemat}
          class="text-emerald-400 hover:text-emerald-300 transition-colors"
          target="_blank"
          rel="noopener noreferrer">Live app →</a
        >
        <a href="/work/srdb-online-demat" class="text-blue-400 hover:text-blue-300 transition-colors"
          >Case study →</a
        >
      </div>
    </article>
  </div>
</section>

<!-- Selected product work -->
<section class="mb-10 border-t border-dark-border pt-8">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <h2 class="section-label mb-1">Selected product work</h2>
      <p class="text-xs text-text-muted">Outcome-first — what shipped for remote product teams</p>
    </div>
    <a href="/work" class="text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors"
      >All selected work →</a
    >
  </div>
  <div class="space-y-4">
    <article class="panel">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h3 class="font-semibold text-lg">Hourmarket</h3>
        <span class="text-xs font-mono text-text-muted">UK · Oct 2024 – Oct 2025</span>
      </div>
      <p class="text-xs font-mono text-emerald-400 mb-3">
        Page builder · React Native shopping app · .NET → NestJS · unified auth
      </p>
      <p class="text-sm text-text-muted">
        Built a visual page builder for web, mobile screens, and email; shipped a consumer React
        Native shopping app on iOS and Android; migrated backend services from .NET to NestJS;
        designed auth shared across products.
        Same schema-driven builder pattern later refined for NMB's regulated brand.
      </p>
    </article>
    <article class="panel">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h3 class="font-semibold text-lg">Sponsorvista</h3>
        <span class="text-xs font-mono text-text-muted">NL · Dec 2025 – Present</span>
      </div>
      <p class="text-xs font-mono text-blue-400 mb-3">Lead execution · deployments · remote team</p>
      <p class="text-sm text-text-muted">
        Own delivery of a production SaaS platform from requirements to deploy; set review and
        release standards across a distributed team.
      </p>
    </article>
    <article class="panel">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h3 class="font-semibold text-lg">Basework.io</h3>
        <span class="text-xs font-mono text-text-muted">US · Jan – May 2024</span>
      </div>
      <p class="text-xs font-mono text-amber-400 mb-3">Banking onboarding · AI products</p>
      <p class="text-sm text-text-muted">
        Digital account-onboarding flows for a Nepali bank, plus LLM-based resume/interview and
        chatbot products.
      </p>
    </article>
  </div>
</section>

<!-- Systems work -->
<section class="mb-10 border-t border-dark-border pt-8">
  <h2 class="section-label mb-1">Systems work</h2>
  <p class="text-xs text-text-muted mb-6">Below the framework — artifacts over adjectives</p>
  <div class="space-y-4">
    {
      systemsProjects.map((project) => (
        <article class="panel">
          <h3 class="font-semibold text-lg mb-1">{project.title}</h3>
          <p class="text-xs font-mono text-blue-400 mb-3">{project.stack}</p>
          <p class="text-sm text-text-muted mb-4">{project.blurb}</p>
          <ul class="space-y-2 text-sm text-text-muted mb-4">
            {project.bullets.map((bullet) => (
              <li class="check-item">{bullet}</li>
            ))}
          </ul>
          {project.href ? (
            <a
              href={project.href}
              class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              Repository →
            </a>
          ) : (
            <p class="text-xs font-mono text-text-muted/70">Public repo link coming soon</p>
          )}
        </article>
      ))
    }
  </div>
</section>

<!-- Lanceme Up -->
<section class="mb-10 border-t border-dark-border pt-8">
  <h2 class="section-label mb-1">Case study · video</h2>
  <p class="text-xs text-text-muted mb-6">Product no longer online — walkthrough instead</p>
  <article class="panel">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
      <h3 class="font-semibold text-lg">Lanceme Up</h3>
      <span class="text-xs font-mono text-text-muted">Jul 2022 – Dec 2023</span>
    </div>
    <p class="text-xs font-mono text-purple-400 mb-3">Frontend · real-time collaboration · CI/CD</p>
    <p class="text-sm text-text-muted mb-4">
      Real-time chat and huddle UI, custom file management, and an internal email client for a
      collaboration workspace used by agencies and teams. The original product domain is no longer
      live, so I keep recorded walkthroughs as proof of what shipped.
    </p>
    <div class="flex flex-wrap gap-4 text-xs font-mono">
      <a href="/work/lanceme-up" class="text-emerald-400 hover:text-emerald-300 transition-colors"
        >Written case study →</a
      >
      {
        LINKS.lancemeUpVideo ? (
          <a
            href={LINKS.lancemeUpVideo}
            class="text-blue-400 hover:text-blue-300 transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch walkthrough →
          </a>
        ) : (
          <span class="text-text-muted/70">Video link pending</span>
        )
      }
    </div>
  </article>
</section>

<!-- Open source -->
<section class="mb-10 border-t border-dark-border pt-8">
  <h2 class="section-label mb-1">Open source</h2>
  <p class="text-xs text-text-muted mb-6">Found in production · fixed upstream</p>
  <article class="panel">
    <h3 class="font-semibold text-lg mb-1">postalsys/imapflow</h3>
    <p class="text-xs font-mono text-amber-400 mb-3">Node.js IMAP client · PR #111 merged</p>
    <p class="text-sm text-text-muted mb-4">
      While building an internal email client, calling <code class="text-white/80">list()</code> without
      options crashed even though TypeScript marked options as optional. Traced it to a missing
      default at runtime and sent a one-line fix upstream — merged the next day.
    </p>
    <a
      href={LINKS.imapflowPr}
      class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors"
      target="_blank"
      rel="noopener noreferrer">View merged PR →</a
    >
  </article>
</section>

<!-- Recommendations -->
<section class="mb-10 border-t border-dark-border pt-8">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <h2 class="section-label mb-1">What people say</h2>
      <p class="text-xs text-text-muted">Founder & co-founder endorsements</p>
    </div>
    <a
      href={LINKS.recommendations}
      class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors whitespace-nowrap"
      target="_blank"
      rel="noopener noreferrer">View on LinkedIn →</a
    >
  </div>

  <div class="space-y-4">
    <article class="recommendation-card">
      <div class="flex gap-4">
        <div
          class="avatar bg-gradient-to-br from-blue-500/30 to-emerald-500/30 text-blue-300 border border-blue-500/20"
          >LB</div
        >
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <p class="font-semibold">Leks Betlem</p>
            <span class="text-xs text-text-muted font-mono">Jun 2026</span>
          </div>
          <p class="text-sm text-blue-400/90 mb-3">Co-founder · Sponsorvista</p>
          <p class="quote-mark mb-1" aria-hidden="true">“</p>
          <blockquote class="text-sm text-text-muted leading-relaxed -mt-4 pl-1">
            I had the pleasure of working with Niraj on a project that I engaged him for, and it was
            a great experience from start to finish. Niraj is a strong team lead who combines
            technical expertise with a practical and collaborative approach.
          </blockquote>
        </div>
      </div>
    </article>

    <article class="recommendation-card">
      <div class="flex gap-4">
        <div
          class="avatar bg-gradient-to-br from-emerald-500/30 to-teal-500/30 text-emerald-300 border border-emerald-500/20"
          >GB</div
        >
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <p class="font-semibold">Gavin Bryan</p>
            <span class="text-xs text-text-muted font-mono">Dec 2025</span>
          </div>
          <p class="text-sm text-emerald-400/90 mb-3">Founder · Hourmarket</p>
          <p class="quote-mark mb-1" aria-hidden="true">“</p>
          <blockquote class="text-sm text-text-muted leading-relaxed -mt-4 pl-1">
            I've worked closely with Niraj on a number of projects across frontend, backend, and
            mobile development, and I've always been impressed with his talent and work ethic.
          </blockquote>
        </div>
      </div>
    </article>
  </div>
</section>

