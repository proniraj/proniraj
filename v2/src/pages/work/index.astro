---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WorkEntry from "../../components/WorkEntry.astro";
import { getWorkEntriesSorted } from "../../lib/work-utils";

const entries = await getWorkEntriesSorted();
---

<MainLayout
  title="Selected Work"
  description="Products and platforms I've helped ship in production — what the situation was, what I worked on, and what changed."
  maxWidth="4xl"
>
  <div slot="header" class="max-w-3xl mx-auto px-6 pt-12 pb-4 w-full">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Selected Work" }]} />
    <p class="font-mono text-sm text-emerald-400/90 mb-3">Selected Work</p>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-5 tracking-tight">
      Work in production
    </h1>
    <p class="text-lg text-text-muted leading-relaxed max-w-2xl">
      A concise record of products and platforms I've contributed to — the context, my
      involvement, and what shipped. Pulled from real engagements, not a project gallery.
    </p>
  </div>

  <div class="work-index-list max-w-3xl mx-auto px-6 pb-4 w-full">
    {entries.map((entry, index) => (
      <WorkEntry entry={entry} index={index} />
    ))}
  </div>

  <p class="max-w-3xl mx-auto px-6 pb-8 text-sm text-text-muted font-mono">
    For longer technical write-ups, see
    <a href="/case-studies" class="text-blue-400 hover:text-blue-300 transition-colors ml-1"
      >Production Systems</a
    >.
  </p>
</MainLayout>
