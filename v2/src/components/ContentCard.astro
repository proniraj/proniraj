---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";
import { getSectionPath, type ContentSection } from "../lib/content-sections";

interface Props {
  entry: CollectionEntry<"thoughts"> | CollectionEntry<"caseStudies">;
  section: ContentSection;
}

const { entry, section } = Astro.props;
const { title, description, publishedAt, readTime, tags, status } = entry.data;
const dateStr = publishedAt.toISOString().slice(0, 10);
const href = getSectionPath(section, entry.id);
---

<a href={href} class="thought-item block no-underline text-inherit">
  <div class="flex items-start justify-between mb-2 gap-4">
    <div class="flex flex-wrap items-center gap-4">
      {status && <StatusBadge status={status} pulse={status === "HOT" || status === "FEATURED"} />}
      <span class="text-xs text-text-muted font-mono">
        {dateStr}{readTime ? ` · ${readTime}` : ""}
      </span>
    </div>
  </div>
  <h3 class="text-lg font-semibold mb-2 text-white">{title}</h3>
  <p class="text-text-muted mb-3 leading-relaxed">{description}</p>
  <div class="flex items-center justify-between gap-4">
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <span class="px-2 py-1 bg-blue-900/30 text-blue-400 text-xs rounded">#{tag}</span>
          ))}
        </div>
      )
    }
    <span class="text-blue-400 text-sm shrink-0">Read More →</span>
  </div>
</a>
